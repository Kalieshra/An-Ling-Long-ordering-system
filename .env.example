# Django
DJANGO_SETTINGS_MODULE=rms.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,asgi

# Database — host-side default (compose overrides to db:5432)
POSTGRES_DB=rms
POSTGRES_USER=rms
POSTGRES_PASSWORD=rms
DATABASE_URL=postgres://rms:rms@localhost:15432/rms

# Redis — host-side default (compose overrides to redis:6379)
REDIS_URL=redis://localhost:16379/0
CHANNEL_LAYERS_URL=redis://localhost:16379/1

# JWT (must be 32+ bytes for HS256 per RFC 7518; replace before deploy)
SIMPLE_JWT_SIGNING_KEY=replace-me-with-a-32-byte-or-longer-random-string-for-jwt-hs256

# CORS (explicit allowlist, comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
